Host github.com
  IdentityFile ~/.ssh/identity/anderson

Host vondel-nord
  IdentityFile ~/.ssh/access/vondel
  RemoteForward 127.0.0.1:61413 127.0.0.1:61413
  ExitOnForwardFailure yes
  ServerAliveInterval 30
  ServerAliveCountMax 3
  User anderson

Host vondel-tunnel
  HostName vondel-nord
  IdentityFile ~/.ssh/access/vondel
  LocalForward 8443 127.0.0.1:8443
  LocalForward 45586 127.0.0.1:45586
  ExitOnForwardFailure yes
  ServerAliveInterval 30
  ServerAliveCountMax 3
  User anderson

Host lyndon-nord
  ExitOnForwardFailure yes
  ServerAliveInterval 30
  ServerAliveCountMax 3
  User anderson

Host *
  AddKeysToAgent yes
  ForwardAgent no
  HashKnownHosts yes
