{
  "$schema": "https://opencode.ai/config.json",
  "model": "zai-coding-plan/glm-5.3#high",
  "agents": {
    "explore": {
      "model": "zai-coding-plan/glm-5.3-flash",
    },
  },
  "plugins": [
    {
      "package": "@plannotator/opencode@0.28.60",
      "options": {
        "workflow": "manual",
      },
    },
  ],
  "websearch": {
    "provider": "tinyfish",
  },
}
