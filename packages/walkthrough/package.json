{
  "name": "walkthrough",
  "version": "0.1.0",
  "private": true,
  "description": "deterministic commit walkthrough pages from git plus a curated sidecar",
  "type": "module",
  "bin": {
    "wt": "./bin/wt.cjs"
  },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=cjs --banner:js=\"#!/usr/bin/env node\" --outfile=bin/wt.cjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
